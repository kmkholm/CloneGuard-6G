# RAN node: UERANSIM 3.2.6 (nr-gnb / nr-ue) + python3 CSI-replay emitter
FROM gradiant/ueransim:3.2.6
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-numpy iproute2 iputils-ping tcpdump procps gettext-base \
 && rm -rf /var/lib/apt/lists/*
COPY node.py /app/node.py
ENTRYPOINT []
CMD ["python3", "/app/node.py"]
