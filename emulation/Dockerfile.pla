# Physical-layer authenticator node: PyTorch (CPU) inference service
FROM python:3.12-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 iputils-ping procps \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir numpy torch --index-url https://download.pytorch.org/whl/cpu
COPY node.py model.py data.py /app/
CMD ["python3", "/app/node.py"]
